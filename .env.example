# Copy to backend/.env and adjust. All variables are optional for a local demo.
PRAMANA_DATA_DIR=../var
# PRAMANA_DATABASE_URL=postgresql+psycopg://pramana:pramana@localhost/pramana
# Base64 256-bit key that wraps each document's own data key; generated into var/keys/master if unset
# Generate with: python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
# PRAMANA_MASTER_KEY=
# Only needed to read files stored before per-document keys existed (legacy Fernet)
# PRAMANA_STORAGE_KEY=
# Local fine-tuned extractor for fields the patterns miss (needs Ollama with the pramana-extract model)
# PRAMANA_LLM_PROVIDERS=ollama
PRAMANA_PKI_FETCH_REVOCATION=false
PRAMANA_DEMO_MODE=true
PRAMANA_COOKIE_SECURE=false
