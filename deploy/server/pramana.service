[Unit]
Description=Pramana public demo
After=network-online.target
Wants=network-online.target

[Service]
User=pramana
Group=pramana
WorkingDirectory=/opt/pramana/backend
# Only Caddy on this host talks to the app; it passes the visitor's address for the sign-in limits
ExecStart=/opt/pramana/backend/.venv/bin/uvicorn pramana.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/pramana

[Install]
WantedBy=multi-user.target
